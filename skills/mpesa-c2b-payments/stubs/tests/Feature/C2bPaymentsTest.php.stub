<?php

use App\Events\MpesaPaymentReceived;
use App\Models\MpesaTransaction;
use App\Support\Mpesa\Daraja;
use Illuminate\Foundation\Testing\RefreshDatabase;
use Illuminate\Http\Client\Request;
use Illuminate\Support\Facades\Event;
use Illuminate\Support\Facades\Http;

uses(RefreshDatabase::class);

beforeEach(function () {
    config([
        'mpesa.environment' => 'sandbox',
        'mpesa.consumer_key' => 'key',
        'mpesa.consumer_secret' => 'secret',
        'mpesa.shortcode' => '600000',
        'mpesa.callback_token' => 'callback-secret',
        'mpesa.callback_base_url' => 'https://shop.test',
        'mpesa.c2b_response_type' => 'Completed',
        'mpesa.c2b_account_pattern' => null,
    ]);
});

function c2bPayment(array $overrides = []): array
{
    return [
        'TransactionType' => 'Pay Bill',
        'TransID' => 'RKTQDM7W6S',
        'TransTime' => '20260102093000',
        'TransAmount' => '1500.00',
        'BusinessShortCode' => '600000',
        'BillRefNumber' => 'INV-1042',
        'InvoiceNumber' => '',
        'OrgAccountBalance' => '49197.00',
        'ThirdPartyTransID' => '',
        'MSISDN' => '2547 ***** 126',
        'FirstName' => 'Jane',
        'MiddleName' => '',
        'LastName' => 'Doe',
        ...$overrides,
    ];
}

test('the URLs are registered for the short code, without words Safaricom rejects', function () {
    Http::fake([
        'sandbox.safaricom.co.ke/oauth/*' => Http::response(['access_token' => 't', 'expires_in' => '3599']),
        'sandbox.safaricom.co.ke/mpesa/c2b/v1/registerurl' => Http::response(['ResponseCode' => '0', 'ResponseDescription' => 'Success']),
    ]);

    $this->artisan('mpesa:register-c2b-urls')->expectsOutputToContain('Success')->assertSuccessful();

    Http::assertSent(function (Request $request) {
        if (! str_contains($request->url(), 'registerurl')) {
            return false;
        }

        $paths = strtolower(parse_url($request['ConfirmationURL'], PHP_URL_PATH).parse_url($request['ValidationURL'], PHP_URL_PATH));

        return $request['ShortCode'] === '600000'
            && $request['ResponseType'] === 'Completed'
            && $request['ConfirmationURL'] === 'https://shop.test/payments/c2b/confirm/callback-secret'
            && $request['ValidationURL'] === 'https://shop.test/payments/c2b/validate/callback-secret'
            && collect(Daraja::FORBIDDEN_URL_WORDS)->every(fn ($word) => ! str_contains($paths, $word));
    });
});

test('registering fails clearly when M-Pesa is not set up', function () {
    config(['mpesa.consumer_key' => null]);

    $this->artisan('mpesa:register-c2b-urls')->assertFailed();
});

test('a confirmed payment is stored once and announced once, however often Safaricom retries', function () {
    Event::fake([MpesaPaymentReceived::class]);

    foreach (range(1, 3) as $attempt) {
        $this->postJson(route('mpesa.c2b.confirm', 'callback-secret'), c2bPayment())
            ->assertOk()->assertJson(['ResultCode' => '0']);
    }

    $transaction = MpesaTransaction::sole();
    expect($transaction)
        ->trans_id->toBe('RKTQDM7W6S')
        ->amount->toBe('1500.00')
        ->bill_ref_number->toBe('INV-1042')
        ->org_account_balance->toBe('49197.00')
        ->msisdn->toBe('2547 ***** 126')
        ->and($transaction->customerName())->toBe('Jane Doe')
        // 09:30 in Nairobi is 06:30 UTC.
        ->and($transaction->transacted_at->utc()->toDateTimeString())->toBe('2026-01-02 06:30:00');

    Event::assertDispatchedTimes(MpesaPaymentReceived::class, 1);
});

test('validation accepts good payments and rejects bad ones with Safaricom\'s codes', function () {
    config(['mpesa.c2b_account_pattern' => '/^INV-\d+$/', 'mpesa.min_amount' => 10]);

    $this->postJson(route('mpesa.c2b.validate', 'callback-secret'), c2bPayment())
        ->assertJson(['ResultCode' => '0', 'ResultDesc' => 'Accepted']);
    $this->postJson(route('mpesa.c2b.validate', 'callback-secret'), c2bPayment(['BillRefNumber' => 'hello']))
        ->assertJson(['ResultCode' => 'C2B00012', 'ResultDesc' => 'Rejected']);
    $this->postJson(route('mpesa.c2b.validate', 'callback-secret'), c2bPayment(['TransAmount' => '5.00']))
        ->assertJson(['ResultCode' => 'C2B00013', 'ResultDesc' => 'Rejected']);
});

test('callbacks without the secret token are not found', function (string $route) {
    $this->postJson(route($route, 'wrong'), c2bPayment())->assertNotFound();

    expect(MpesaTransaction::count())->toBe(0);
})->with(['mpesa.c2b.confirm', 'mpesa.c2b.validate']);

test('a confirmation without a receipt number is acknowledged but not stored', function () {
    $this->postJson(route('mpesa.c2b.confirm', 'callback-secret'), c2bPayment(['TransID' => '']))->assertOk();

    expect(MpesaTransaction::count())->toBe(0);
});
