<?php

use App\Http\Controllers\Mpesa\C2bController;
use Illuminate\Foundation\Http\Middleware\ValidateCsrfToken;
use Illuminate\Support\Facades\Route;

// Called by Safaricom's servers: no CSRF token, protected by the secret token in the URL.
// The paths avoid the words Safaricom rejects in URLs ("mpesa", "safaricom", "query"...).
Route::controller(C2bController::class)
    ->name('mpesa.c2b.')
    ->withoutMiddleware(ValidateCsrfToken::class)
    ->middleware('throttle:600,1')
    ->group(function () {
        Route::post('payments/c2b/validate/{token}', 'validatePayment')->name('validate');
        Route::post('payments/c2b/confirm/{token}', 'confirm')->name('confirm');
    });
