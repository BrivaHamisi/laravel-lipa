<?php

use App\Http\Controllers\Mpesa\B2cCallbackController;
use Illuminate\Foundation\Http\Middleware\ValidateCsrfToken;
use Illuminate\Support\Facades\Route;

// Only Safaricom's result callbacks are routes. Starting a payout is never exposed over HTTP.
// The paths avoid the words Safaricom rejects in URLs ("mpesa", "safaricom", "query"...).
Route::controller(B2cCallbackController::class)
    ->name('mpesa.b2c.')
    ->withoutMiddleware(ValidateCsrfToken::class)
    ->middleware('throttle:600,1')
    ->group(function () {
        Route::post('payments/b2c/result/{token}', 'result')->name('result');
        Route::post('payments/b2c/timeout/{token}', 'timeout')->name('timeout');
    });
