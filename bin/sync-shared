#!/usr/bin/env bash
# Copy the shared files into every skill that ships them.
set -euo pipefail
root="$(cd "$(dirname "$0")/.." && pwd)"
for skill in mpesa-stk-push mpesa-c2b-payments mpesa-b2c-payouts; do
    cp -R "$root/.shared/daraja/." "$root/skills/$skill/stubs/"
done
cp -R "$root/.shared/payments/." "$root/skills/mpesa-stk-push/stubs/"
echo "Synced .shared into the skills."
